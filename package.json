{
  "name": "streefight",
  "productName": "StreeFight",
  "version": "1.0.0",
  "description": "StreeFight - an original retro-style 2D fighting game",
  "main": "main.js",
  "author": "StreeFight",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:x64": "electron-builder --win --x64 --publish never -c.nsis.artifactName=StreeFight-Setup-${version}-x64.${ext}",
    "dist:arm64": "electron-builder --win --arm64 --publish never -c.nsis.artifactName=StreeFight-Setup-${version}-arm64.${ext}",
    "dist:universal": "electron-builder --win --x64 --arm64 --publish never -c.nsis.artifactName=StreeFight-Setup-${version}-universal.${ext}",
    "dist": "npm run dist:x64 && npm run dist:arm64 && npm run dist:universal"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.streefight.game",
    "productName": "StreeFight",
    "files": [
      "main.js",
      "src/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StreeFight"
    }
  }
}
